# เลือกผู้ให้บริการ: xkiro หรือ cloudflare-thaillm
PHOTOKEEP_GATEWAY_PROVIDER=xkiro
# ที่อยู่ Gateway; ใช้ 127.0.0.1 เมื่อแอปรันบนเครื่องเดียวกัน
PHOTOKEEP_GATEWAY_LISTEN=127.0.0.1:8081
# จำนวนงานพร้อมกัน; ค่าเริ่มต้น 64 สำหรับ xKiro, ตั้งเองได้ 1-128
PHOTOKEEP_GATEWAY_CONCURRENCY=64
# สำรองไป API กลางเมื่อ provider หลักตอบ HTTP 429; ใช้ off เพื่อปิด fallback
PHOTOKEEP_GATEWAY_FALLBACK_URL=https://vision.k1god.com/v1/analyze
# ใส่เฉพาะเมื่อ API สำรองกำหนด key; เว้นว่างถ้าไม่ต้องใช้
PHOTOKEEP_GATEWAY_FALLBACK_API_KEY=
# Header สำหรับ key สำรอง; ค่าเริ่มต้นที่ใช้ได้คือ x-api-key
PHOTOKEEP_GATEWAY_FALLBACK_API_KEY_HEADER=x-api-key
# รหัสป้องกัน Gateway; เว้นว่างเมื่อใช้งานเฉพาะในเครื่อง
PHOTOKEEP_GATEWAY_TOKEN=

# xKiro: ใส่หลายคีย์โดยคั่นด้วยจุลภาคหรือขึ้นบรรทัดใหม่
XKIRO_API_KEYS=
# ใช้คีย์เดียวแบบเดิมได้ หากไม่ได้ตั้ง XKIRO_API_KEYS
XKIRO_API_KEY=
# ชื่อโมเดล xKiro
XKIRO_MODEL=mistralai/mistral-medium-3.5
# หน่วงระหว่างคำขอต่อคีย์ xKiro หน่วยมิลลิวินาที
XKIRO_MIN_INTERVAL_MS=600

# Cloudflare: ใส่ Account ID:Token แต่ละบัญชีคั่นด้วยจุลภาค
CLOUDFLARE_ACCOUNTS=
# ThaiLLM: ใส่หลาย API key คั่นด้วยจุลภาคหรือขึ้นบรรทัดใหม่
THAILLM_API_KEYS=
# ชื่อโมเดลภาษาไทยที่ใช้สร้างคำอธิบายและแท็ก
THAILLM_MODEL=openthaigpt-thaillm-8b-instruct-v7.2
